# Copy to .env.local (git-ignored). Every value is optional.
#
# VITE_AI_PROVIDER   mock | http        (default: mock — deterministic, offline, no key needed)
# VITE_AI_ENDPOINT   URL of the LLM API called by src/ai/provider.js. The wire format is picked from it:
#                      …/v1/messages (or anthropic.com)  → Anthropic Messages API
#                      anything else                    → OpenAI-compatible /chat/completions
#                    Examples:
#                      https://api.anthropic.com/v1/messages
#                      https://api.openai.com/v1/chat/completions
#                      https://api.groq.com/openai/v1/chat/completions
#                      https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#                      http://localhost:11434/v1/chat/completions   (Ollama, no key)
# VITE_AI_API_KEY    key for that API (never commit a real key; it is visible to the browser)
# VITE_AI_MODEL      model name passed through to the API
VITE_AI_PROVIDER=mock
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=
